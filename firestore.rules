rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function acceptedPair(path, fromId, toId) {
      return exists(path) && get(path).data.status == 'accepted'
        && get(path).data.fromId == fromId && get(path).data.toId == toId;
    }
    function friend(userId) {
      return request.auth != null && (
        acceptedPair(/databases/$(database)/documents/friendships/$(request.auth.uid + '~' + userId), request.auth.uid, userId)
        || acceptedPair(/databases/$(database)/documents/friendships/$(userId + '~' + request.auth.uid), userId, request.auth.uid)
      );
    }
    function validFriendship() {
      let item = request.resource.data;
      return item.keys().hasAll(['fromId', 'toId', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'])
        && item.keys().hasOnly(['fromId', 'toId', 'fromName', 'toName', 'status', 'createdAt', 'updatedAt'])
        && item.fromId is string && item.fromId.matches('[a-zA-Z0-9_-]{1,128}')
        && item.toId is string && item.toId.matches('[a-zA-Z0-9_-]{1,128}')
        && item.fromId != item.toId
        && item.fromName is string && item.fromName.size() > 0 && item.fromName.size() <= 60
        && item.toName is string && item.toName.size() <= 60
        && item.status in ['pending', 'accepted']
        && item.createdAt is timestamp && item.updatedAt is timestamp;
    }
    function validActivity(userId) {
      let item = request.resource.data;
      let gamePath = /databases/$(database)/documents/users/$(userId)/games/$(item.gameId);
      return item.keys().hasAll(['actorId', 'actorName', 'gameId', 'gameTitle', 'coverUrl', 'type', 'status', 'statusLabel', 'createdAt'])
        && item.keys().hasOnly(['actorId', 'actorName', 'gameId', 'gameTitle', 'coverUrl', 'type', 'status', 'statusLabel', 'createdAt'])
        && item.actorId == userId
        && item.actorName is string && item.actorName.size() > 0 && item.actorName.size() <= 60
        && item.gameId is string && item.gameId.matches('[a-zA-Z0-9_-]{1,128}')
        && item.gameTitle is string && item.gameTitle.size() > 0 && item.gameTitle.size() <= 120
        && item.coverUrl is string && item.coverUrl.size() <= 2000
        && item.status is string && item.statusLabel is string && item.statusLabel.size() > 0 && item.statusLabel.size() <= 60
        && item.createdAt is timestamp && item.createdAt == request.time
        && getAfter(gamePath).data.title == item.gameTitle
        && getAfter(gamePath).data.coverUrl == item.coverUrl
        && getAfter(gamePath).data.status == item.status
        && ((item.type == 'added' && !exists(gamePath))
          || (item.type == 'status' && (!exists(gamePath) || get(gamePath).data.status != item.status)));
    }
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function defaultList(id) {
      return id in ['playing', 'completed', 'planned', 'platinum', 'dropped'];
    }
    function defaultGenre(id) {
      return id in ['Ação', 'Aventura', 'RPG', 'Roguelike', 'Metroidvania', 'Plataforma', 'Puzzle', 'Estratégia', 'Simulação', 'Esporte', 'Corrida', 'FPS', 'Terror', 'Luta', 'MMO', 'Outro'];
    }
    function usableOption(userId, id, kind) {
      let globalPath = /databases/$(database)/documents/taxonomy/$(id);
      let personalPath = /databases/$(database)/documents/users/$(userId)/options/$(id);
      return exists(globalPath)
        ? (get(globalPath).data.kind == kind && get(globalPath).data.active == true)
        : exists(personalPath)
          ? (get(personalPath).data.kind == kind && get(personalPath).data.active == true)
          : ((kind == 'list' && defaultList(id)) || (kind == 'genre' && defaultGenre(id)));
    }
    function validOption() {
      let option = request.resource.data;
      return option.keys().hasAll(['kind', 'label', 'color', 'icon', 'completed', 'active', 'createdAt', 'updatedAt'])
        && option.keys().hasOnly(['kind', 'label', 'color', 'icon', 'completed', 'active', 'createdAt', 'updatedAt'])
        && option.kind in ['list', 'genre']
        && option.label is string && option.label.size() > 0 && option.label.size() <= 60
        && option.color in ['green', 'blue', 'gold', 'rose', 'gray']
        && option.icon in ['play', 'check', 'bookmark', 'trophy', 'pause', 'library']
        && option.completed is bool && (option.kind == 'list' || option.completed == false)
        && option.active is bool
        && option.createdAt is number && option.createdAt >= 0
        && option.updatedAt is number && option.updatedAt >= option.createdAt;
    }
    function validGlobalId(id) {
      return (defaultList(id) && request.resource.data.kind == 'list')
        || (defaultGenre(id) && request.resource.data.kind == 'genre')
        || id.matches('global-[a-zA-Z0-9-]{1,80}');
    }
    function validGame() {
      let game = request.resource.data;
      return game.keys().hasAll(['title', 'genre', 'status', 'rating', 'coverUrl', 'review', 'rank', 'createdAt', 'updatedAt'])
        && game.keys().hasOnly(['title', 'genre', 'status', 'rating', 'coverUrl', 'review', 'rank', 'createdAt', 'updatedAt'])
        && game.title is string && game.title.size() > 0 && game.title.size() <= 120
        && game.genre is string && game.genre.size() > 0 && game.genre.size() <= 100 && !game.genre.matches('.*[/].*')
        && game.status is string && game.status.size() > 0 && game.status.size() <= 100 && !game.status.matches('.*[/].*')
        && game.rating in [0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5]
        && game.coverUrl is string && game.coverUrl.size() <= 2000
        && (game.coverUrl == '' || game.coverUrl.matches('https?://.*') || game.coverUrl.matches('/covers/[a-zA-Z0-9-]+[.]jpg'))
        && game.review is string && game.review.size() <= 3000
        && game.rank is number && game.rank > -1000000000000000 && game.rank < 1000000000000000
        && game.createdAt is number && game.createdAt >= 0
        && game.updatedAt is number && game.updatedAt >= game.createdAt;
    }
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if request.auth != null && validFriendship()
        && request.resource.data.fromId == request.auth.uid
        && friendshipId == request.resource.data.fromId + '~' + request.resource.data.toId
        && request.resource.data.status == 'pending' && request.resource.data.toName == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/friendships/$(request.resource.data.toId + '~' + request.resource.data.fromId));
      allow update: if request.auth != null && validFriendship()
        && resource.data.toId == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted' && request.resource.data.toName.size() > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'toName', 'updatedAt']);
      allow delete: if request.auth != null && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }
    match /users/{userId}/activities/{activityId} {
      allow read: if owner(userId) || friend(userId);
      allow create: if owner(userId) && validActivity(userId);
      allow update, delete: if false;
    }
    match /admins/{userId} {
      allow get: if owner(userId);
      // A promoção de administrador acontece no Console do Firebase ou Admin SDK.
      allow list, create, update, delete: if false;
    }
    match /users/{userId}/profile/{profileId} {
      allow read: if profileId == 'main' && (owner(userId) || friend(userId));
      allow delete: if owner(userId) && profileId == 'main';
      allow create, update: if owner(userId) && profileId == 'main'
        && request.resource.data.keys().hasAll(['displayName', 'photoData', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'photoData', 'updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.photoData is string && request.resource.data.photoData.size() <= 180000
        && (request.resource.data.photoData == '' || request.resource.data.photoData.matches('data:image/jpeg;base64,[a-zA-Z0-9+/=]+'))
        && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0;
    }
    match /taxonomy/{optionId} {
      allow read: if request.auth != null;
      allow create: if admin() && validOption() && validGlobalId(optionId);
      allow update: if admin() && validOption() && validGlobalId(optionId)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt;
      // Arquivar preserva as referências dos jogos de todas as contas.
      allow delete: if false;
    }
    match /users/{userId}/options/{optionId} {
      allow read: if owner(userId) || friend(userId);
      allow create: if owner(userId) && validOption() && optionId.matches('personal-[a-zA-Z0-9-]{1,80}');
      allow update: if owner(userId) && validOption() && optionId.matches('personal-[a-zA-Z0-9-]{1,80}')
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /users/{userId}/games/{gameId} {
      allow read: if owner(userId) || friend(userId);
      allow delete: if owner(userId);
      allow create: if owner(userId) && validGame()
        && usableOption(userId, request.resource.data.status, 'list')
        && usableOption(userId, request.resource.data.genre, 'genre');
      allow update: if owner(userId) && validGame()
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.status == resource.data.status || usableOption(userId, request.resource.data.status, 'list'))
        && (request.resource.data.genre == resource.data.genre || usableOption(userId, request.resource.data.genre, 'genre'));
    }
  }
}
